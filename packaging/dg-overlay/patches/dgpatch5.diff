+// they are what bounds context. Counts:
+//   - the F16 store: full-attention layers keep every position, sliding layers a ring of n_swa-1+n_ubatch rows;
+//   - the DECODE graph's working copies of K,V over n_ctx keys for the widest layer that sees them all (F32
+//     read, concat, pad: ~3 live copies);
+//   - the device-resident self-conditioning canvas logits.
+// Measured on gfx1201 (n_ubatch 2048) at 60.6K tokens: the runner grew 2.88 GiB and this returns 3.38 GiB.
+// 0 for non-DiffusionGemma.
+size_t llama_diffusion_fa_turn_bytes(const struct llama_model * model, int64_t n_ctx, int64_t n_ubatch) {
+    const auto * dm = dynamic_cast<const llama_model_diffusion_gemma *>(model);
+    if (!dm) {
+        return 0;
+    }
+    const auto & hp     = dm->hparams;
+    const bool   window = dg_swa_window_on(hp);
+    size_t store  = 0;
+    size_t widest = 0;   // K+V elements per position of the widest layer that attends over all n_ctx keys
+    for (int il = 0; il < (int) hp.n_layer(); ++il) {
+        const size_t row  = (size_t) hp.n_embd_head_k(il) * hp.n_head_kv(il) * 2;
+        const bool   ring = window && hp.is_swa(il);   // reads at most n_swa-1 prompt keys: bounded, not per-token
+        store += row * sizeof(ggml_fp16_t) * (size_t) (ring ? std::min(n_ctx, (int64_t) hp.n_swa - 1 + n_ubatch) : n_ctx);
+        if (!ring) {
